# Browser-safe public values only.
# Never place a service_role key, database password, JWT signing secret, or Turnstile secret in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Public Cloudflare Turnstile site key. The private Turnstile secret belongs only
# in Supabase Authentication > Bot and Abuse Protection.
VITE_TURNSTILE_SITE_KEY=
